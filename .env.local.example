# The Torcia School — local environment template
# Copy this file to .env.local and replace every placeholder with real values.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/torcia_school?retryWrites=true&w=majority

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Admin authentication
# Use a long, random value. Never commit the real secret.
ADMIN_SECRET=replace_with_a_long_random_secret

# SMTP / Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thetorciaschool@gmail.com
SMTP_PASS=your_app_password_here
