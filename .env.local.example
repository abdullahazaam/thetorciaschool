# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/torcia_school?retryWrites=true&w=majority

# Cloudinary Configuration for Image/Media Storage
# Obtain these from your Cloudinary Console (Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Public Cloud Name (used if uploading directly from client-side widgets)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Admin / Auth Security Secret (Optional for session authentication)
ADMIN_SECRET=torcia_secure_admin_secret_key_2026

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thetorciaschool@gmail.com
SMTP_PASS=your_app_password_here
